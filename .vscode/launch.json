{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PHP: Launch current file",
      "type": "php",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-d",
        "xdebug.mode=debug",
        "-d",
        "xdebug.start_with_request=yes",
        "-d",
        "xdebug.client_port=9003",
        "-d",
        "xdebug.client_host=localhost"
      ],
      "port": 9003,
      "stopOnEntry": true
    },
    {
      "name": "PHP: Listen for Xdebug",
      "type": "php",
      "request": "launch",
      "port": 9003
    }
  ]
}